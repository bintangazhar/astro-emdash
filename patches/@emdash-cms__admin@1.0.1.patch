+			if (r10 === 2 && r100 !== 12) return n + "nd";
+			if (r10 === 3 && r100 !== 13) return n + "rd";
+			return n + "th";
+		};
+		const h24 = sample.getHours(), h12 = h24 % 12 || 12;
+		const map = {
