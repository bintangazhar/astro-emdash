+// Formats the fixed sample date 23 January 2026 with the token string typed
+// into the field (date-fns style: yyyy MM dd MMMM MMM EEEE HH mm ...).
+// Falls back to the raw token string when it cannot be applied.
+function __emdashPreviewDateFormat(fmt) {
