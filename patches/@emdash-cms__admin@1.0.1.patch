+			MMMM: monthsLong[sample.getMonth()], MMM: monthsShort[sample.getMonth()], MM: pad(sample.getMonth() + 1, 2), M: String(sample.getMonth() + 1),
+			dd: pad(sample.getDate(), 2), do: ordinal(sample.getDate()), d: String(sample.getDate()),
+			EEEE: daysLong[sample.getDay()], EEE: daysShort[sample.getDay()], EE: daysShort[sample.getDay()], E: daysShort[sample.getDay()],
+			HH: pad(h24, 2), H: String(h24), hh: pad(h12, 2), h: String(h12),
+			mm: pad(sample.getMinutes(), 2), m: String(sample.getMinutes()),
+			ss: pad(sample.getSeconds(), 2), s: String(sample.getSeconds()),
