+		const daysShort = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+		const pad = (n, l) => String(n).padStart(l, "0");
+		const ordinal = (n) => {
+			const r10 = n % 10, r100 = n % 100;
