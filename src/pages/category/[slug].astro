---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";
import { normalizeLocale, localizePath, DEFAULT_LOCALE } from "../../utils/i18n";
import { t } from "../../utils/dict";

const locale = normalizeLocale(Astro.currentLocale);
const L = (p: string) => localizePath(p, locale);

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
	locale,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	// No such term in this locale: try the default-locale URL (which may
	// exist under an untranslated slug) before giving up with a 404.
	if (locale !== DEFAULT_LOCALE) {
		return Astro.redirect(
			localizePath(Astro.url.pathname + Astro.url.search, DEFAULT_LOCALE),
		);
	}
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
	locale,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

// Single batched query for tags on every post in this category, rather
// than calling getEntryTerms() per post (which would be one round-trip
// per post).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
	{ locale },
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={`${t(locale, "inCategory")} ${term.label}`} description={`${t(locale, "allInCategory")} ${term.label}`}>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">{t(locale, "categoryLabel")}</span>
			<h1 class="archive-title">{term.label}</h1>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">{t(locale, "noCategoryPosts")}</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={L(`/posts/${post.id}`)}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							edit={post.edit}
							locale={locale}
						/>
					))}
				</div>
			)
		}
		<nav class="pagination" aria-label={t(locale, "pagination")}>
			{cursor && <a href={L(`/category/${term.slug}`)}>{t(locale, "firstPage")}</a>}
			{
				nextCursor && (
					<a
						href={L(`/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`)}
					>
						{t(locale, "nextPage")}
					</a>
				)
			}
		</nav>
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
