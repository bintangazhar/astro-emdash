---
import { localizePath, normalizeLocale, type SupportedLocale } from "../utils/i18n";

interface Props {
	currentPath?: string;
	locale?: string | null;
}

const { currentPath = "/", locale } = Astro.props;
const active = normalizeLocale(locale ?? Astro.currentLocale);
const locales: { code: SupportedLocale; label: string }[] = [
	{ code: "id", label: "ID" },
	{ code: "en", label: "EN" },
];
---

<div class="lang-switcher" role="group" aria-label="Language / Bahasa">
	{locales.map(({ code, label }, i) => (
		<>
			{i > 0 && <span class="lang-sep" aria-hidden="true">|</span>}
			{code === active ? (
				<span class="lang-active" aria-current="true" lang={code}>{label}</span>
			) : (
				<a class="lang-link" href={localizePath(currentPath, code)} hreflang={code} lang={code}>{label}</a>
			)}
		</>
	))}
</div>

<style>
	.lang-switcher {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		font-size: var(--font-size-sm);
		white-space: nowrap;
	}
	.lang-sep {
		color: var(--color-border);
	}
	.lang-active {
		font-weight: 600;
		color: var(--color-text);
	}
	.lang-link {
		color: var(--color-muted);
		text-decoration: none;
		transition: color var(--transition-fast);
	}
	.lang-link:hover {
		color: var(--color-brand);
	}
</style>
